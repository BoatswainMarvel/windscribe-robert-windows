    <script>
(function() {
    if (window.openWindscribeGarry) {
        return;
    }

    var READINESS_POLL_INTERVAL_MS = 150;
    var READINESS_TIMEOUT_MS = 10000;

    function openGarryWidget() {
        window.setTimeout(function() {
            if (window.GarryWidget && typeof window.GarryWidget.open === 'function') {
                window.GarryWidget.open();
            }
        }, 0);
    }

    window.openWindscribeGarry = function() {
        var startedAt;
        var intervalId;

        if (window.GarryWidget && typeof window.GarryWidget.open === 'function') {
            openGarryWidget();
            return false;
        }

        startedAt = Date.now();
        intervalId = window.setInterval(function() {
            if (window.GarryWidget && typeof window.GarryWidget.open === 'function') {
                window.clearInterval(intervalId);
                openGarryWidget();
                return;
            }

            if (Date.now() - startedAt >= READINESS_TIMEOUT_MS) {
                window.clearInterval(intervalId);
            }
        }, READINESS_POLL_INTERVAL_MS);

        return false;
    };
})();
</script>
