<!-- Sync session cookie to localStorage for Next.js SSG site -->
<script>
(function() {
    var match = document.cookie.match('(?:^|; )ws_session_auth_hash=([^;]*)');
    try {
        if (match) {
            localStorage.setItem('ws_session_auth_hash', decodeURIComponent(match[1]));
        } else {
            localStorage.removeItem('ws_session_auth_hash');
        }
    } catch(e) {}
})();
</script>

